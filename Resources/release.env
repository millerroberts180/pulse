# Where Pulse points people, read by scripts/bundle.sh and scripts/release.sh.
# bundle.sh stamps each value that is set on the bundle's copy of Info.plist;
# the source plist never carries them. Shell syntax: the scripts source this
# file.
#
# These are About's links. Pulse falls back to placeholders on pulse.example
# for the ones left empty, and scripts/release.sh refuses a release until all
# but SUPPORT_URL (an optional help page; support is by email) are set. Pulse
# never opens these itself: only when someone clicks one.
WEBSITE_URL=https://lineapps.vercel.app/pulse/
SUPPORT_URL=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
EULA_URL=
